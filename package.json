{
  "name": "@qeetrix/stories",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "description": "Storybook workshop for @qeetrix/react, the Qeetrix design system (not published).",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "docgen": "node scripts/docgen.mjs",
    "dev": "node scripts/docgen.mjs && storybook dev -p 6006 --no-open",
    "storybook": "node scripts/docgen.mjs && storybook dev -p 6006",
    "build": "node scripts/docgen.mjs && storybook build",
    "shoot": "node scripts/shoot.mjs",
    "test": "node scripts/docgen.mjs && vitest run",
    "test:storybook": "node scripts/docgen.mjs && vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "test:coverage": "node scripts/docgen.mjs && vitest run --coverage",
    "verify:stories": "node scripts/verify-stories.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "node scripts/docgen.mjs && tsc --noEmit",
    "clean": "rm -rf storybook-static screenshots coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@qeetrix/icons": "^2.1.2",
    "@qeetrix/react": "0.5.1",
    "@qeetrix/tokens": "^0.0.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.11"
  }
}
