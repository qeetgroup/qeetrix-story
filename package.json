{
  "name": "@qeetrix/stories",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "description": "Storybook workshop for the Qeetrix design system (not published).",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "storybook": "storybook dev -p 6006",
    "build": "node scripts/gen-llms.mjs && storybook build",
    "llms": "node scripts/gen-llms.mjs",
    "shoot": "node scripts/shoot.mjs",
    "test": "vitest run",
    "test:storybook": "vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "test:coverage": "vitest run --coverage",
    "verify:foundations": "node scripts/verify-foundations.mjs",
    "verify:stories": "node scripts/verify-stories.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "setup:ui": "node scripts/setup-ui.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf storybook-static screenshots coverage"
  },
  "dependencies": {
    "@qeetrix/icons": "1.0.11",
    "@qeetrix/ui": "^2.1.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "playwright": "^1.61.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
